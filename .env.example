# Copy to server/.env (or export these) before starting.

# The first admin, seeded once on an empty user store.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Signs session tokens — set a long random string so logins survive a restart.
#   openssl rand -base64 48
AUTH_SECRET=

# Ports. PUBLIC_PORT serves the app to the team over your LAN.
PORT=8790
PUBLIC_PORT=9044
