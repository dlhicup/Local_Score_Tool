# Copy to server/.env (or export these) before starting.

# The first admin, seeded once on an empty user store. There are no passwords —
# everyone signs in with just their username, so choose accounts you trust on
# your LAN. The admin creates the rest of the team's accounts in the app.
ADMIN_USER=admin

# Signs session tokens — set a long random string so logins survive a restart.
#   openssl rand -base64 48
AUTH_SECRET=

# Ports. PUBLIC_PORT serves the app to the team over your LAN.
PORT=8790
PUBLIC_PORT=9044

# ffmpeg builds the browser-safe H.264 proxies that let Veo/HEVC clips play.
# Leave this unset if ffmpeg is on PATH; set it only for an unusual install,
# e.g. FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFMPEG_PATH=
